# Copy this file to .env and fill in real values. .env itself is gitignored —
# never commit real secrets. This is the file docker-compose.yml reads for
# ${VAR} substitution and passes through to individual services.

# Used by the agent experiment (agent/, Chapter 16). AGENT_BACKEND picks which
# model answers: "ollama" (default, no key needed — just a local model via
# `ollama serve`) or "gemini" (opt-in, needs the key below). None of these
# four lines are required to run the agent with its default backend; they're
# here so the knobs are discoverable even though analyst.py already falls
# back to the same values in code.
# AGENT_BACKEND=ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:7b

# Only used when AGENT_BACKEND=gemini (api docs:
# https://ai.google.dev/gemini-api/docs/api-key). Get a key from
# https://aistudio.google.com/apikey — the free tier is enough for this.
GEMINI_API_KEY=your-gcp-api-key
