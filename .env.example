# Copy this file to .env and fill in real values. .env itself is gitignored —
# never commit real secrets. This is the file docker-compose.yml reads for
# ${VAR} substitution and passes through to individual services.

# Used by the agent experiment (api docs: https://ai.google.dev/gemini-api/docs/api-key)
# Get a key from https://aistudio.google.com/apikey — the free tier is enough for this.
GEMINI_API_KEY=your-gcp-api-key
